+    if (fifo.register_writes.load(std::memory_order_seq_cst) != writes)
+      return;
+    ASSERT_MSG(COMMANDPROCESSOR, distance >= GPFifo::GATHER_PIPE_SIZE,
+               "fifo.CPReadWriteDistance = {} is shorter than the chunk the FIFO loop ran",
