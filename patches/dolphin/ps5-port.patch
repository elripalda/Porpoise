+bool Ps5EnvironCallback(unsigned cmd, void* data)
+{
+  if (cmd == RETRO_ENVIRONMENT_GET_VARIABLE && data)
+  {
+    auto* var = static_cast<retro_variable*>(data);
+    for (const auto& [key, value] : s_ps5_option_overrides)
+    {
